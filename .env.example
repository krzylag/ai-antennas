# Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. An OpenRouter key enables the free DeepSeek model configured below.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Direct DeepSeek API access is paid; it is not selected by default.
DEEPSEEK_API_KEY=

# Local llama.cpp fallback. Leave empty for cloud providers.
# Values: coder, r1, qwen-coder
LOCAL_MODEL=
# 8192 fits Qwen2.5-Coder-7B Q4_K_M and its KV cache within 8 GB VRAM.
LOCAL_CONTEXT_SIZE=8192
LOCAL_GPU_LAYERS=999

# DeepSeek Coder 6.7B Instruct Q4_K_M
LOCAL_CODER_FILE=deepseek-coder-6.7b-instruct.Q4_K_M.gguf
LOCAL_CODER_URL=https://huggingface.co/TheBloke/deepseek-coder-6.7B-instruct-GGUF/resolve/main/deepseek-coder-6.7b-instruct.Q4_K_M.gguf?download=true
LOCAL_CODER_ALIAS=local-deepseek-coder

# DeepSeek-R1-Distill-Qwen-7B Q4_K_M
LOCAL_R1_FILE=DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
LOCAL_R1_URL=https://huggingface.co/bartowski/DeepSeek-R1-Distill-Qwen-7B-GGUF/resolve/main/DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf?download=true
LOCAL_R1_ALIAS=local-deepseek-r1

# Qwen2.5-Coder-7B-Instruct Q4_K_M, with tool calling support
LOCAL_QWEN_CODER_FILE=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
LOCAL_QWEN_CODER_URL=https://huggingface.co/bartowski/Qwen2.5-Coder-7B-Instruct-GGUF/resolve/main/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf?download=true
LOCAL_QWEN_CODER_ALIAS=local-qwen-coder

# On Linux, set these to your host user/group IDs to avoid root-owned workspace files.
LOCAL_UID=1000
LOCAL_GID=1000
